# STAF LAMMPS smoke — 5 NVE steps, ORT CUDA MLP (float32 energy+dE_daf)

units           real
atom_style      atomic
boundary        p p p

read_data       data.water_smoke

pair_style      staf 4.5 4.5 float
pair_coeff      * * /home/francegm/AlphaNesGpu/test/test-lammps-smoke/model_onnx_grad_float
neighbor        0.5 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 5.0

velocity        all create 50.0 791231 dist gaussian

fix             nve all nve
timestep        0.2
thermo          1
thermo_style    custom step temp pe ke etotal

run             5
