# STAF domain-decomposition parity — single force eval (run 0)
# Paths relative to test/test-lammps-dd-parity/

units           real
atom_style      atomic
boundary        p p p
atom_modify     sort 0 0.0

read_data       ../test-lammps-smoke/data.water_smoke

pair_style      staf 4.5 4.5 float
pair_coeff      * * ../test-lammps-smoke/model_onnx_grad_float
neighbor        0.5 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 5.0

thermo          1
thermo_style    custom step pe

dump            1 all custom 1 ${dumpfile} id type fx fy fz
dump_modify     1 sort id

run             0
